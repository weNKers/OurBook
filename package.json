{
  "name": "ourbook",
  "version": "1.0.0",
  "description": "a book: past, present, and future",
  "main": "index.js",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs && node scripts/generate-sitemap.mjs",
    "clean": "node scripts/clean-build.mjs",
    "test:site": "node --test scripts/tests/site-build.test.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:images:remote": "node scripts/audit-images.mjs --remote",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:links:strict": "node scripts/audit-links.mjs --strict",
    "normalize:images": "node scripts/normalize-wikimedia-images.mjs",
    "mark:broken-images": "node scripts/mark-broken-images.mjs",
    "migrate:frontmatter": "node scripts/migrate-frontmatter.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:content:strict": "node scripts/audit-content.mjs --strict",
    "audit": "npm run audit:assets && npm run audit:images && npm run audit:links:strict && npm run audit:content",
    "check": "npm run audit && npm run audit:content:strict && npm run audit:links:strict && npm run test:site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weNKers/OurBook.git"
  },
  "keywords": [
    "nankai",
    "book",
    "university",
    "experience",
    "share",
    "cooperation"
  ],
  "author": "weNKers",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/weNKers/OurBook/issues"
  },
  "homepage": "https://github.com/weNKers/OurBook#readme",
  "devDependencies": {
    "minisearch": "^7.2.0",
    "sass-embedded": "^1.100.0",
    "vitepress": "^1.6.4"
  }
}
